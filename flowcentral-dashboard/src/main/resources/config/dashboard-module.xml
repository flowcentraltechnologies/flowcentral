<?xml version="1.0"?>
<!-- Dashboard module configuration -->
<module
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.flowcentralplatform.com/xsd/4.2.0/flowcentral-module.xsd"
	name="dashboard" description="$m{dashboard.module}"
	shortCode="DSH" label="$m{dashboard.label}">
	<!-- Applications -->
	<applications>
		<application name="dashboard"
			shortDescription="$m{dashboard.short.description}"
			longDescription="$m{dashboard.long.description}" autoInstall="true"
			configFile="apps/dashboard-application.xml" />
	</applications>

	<!-- System Parameters -->
</module>