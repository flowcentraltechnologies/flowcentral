<?xml version="1.0"?>
<!-- OS messaging module configuration -->
<module
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.flowcentralplatform.com/xsd/4.2.0/flowcentral-module.xsd"
	name="osmessaging" description="$m{osmessaging.module}"
	shortCode="OMG" label="$m{osmessaging.label}">
	<!-- Applications -->
	<applications>
		<application name="osmessaging"
			shortDescription="$m{osmessaging.short.description}"
			longDescription="$m{osmessaging.long.description}" autoInstall="true"
			configFile="apps/osmessaging-application.xml" />
	</applications>
	<!-- System Parameters -->
</module>