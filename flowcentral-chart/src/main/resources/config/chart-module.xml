<?xml version="1.0"?>
<!-- Master chart module configuration -->
<module
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.flowcentralplatform.com/xsd/4.2.0/flowcentral-module.xsd"
	name="chart" description="$m{chart.module}" shortCode="CHT"
	label="$m{chart.label}">
	<!-- Applications -->
	<applications>
		<application name="chart"
			shortDescription="$m{chart.short.description}"
			longDescription="$m{chart.long.description}" autoInstall="true"
			configFile="apps/chart-application.xml" />
	</applications>

	<!-- System Parameters -->
</module>