	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation=" https://schema.flowcentralplatform.com/xsd/4.2.0/flowcentral-notificationtemplate.xsd"
	name="userWelcome" description="$m{security.notification.userwelcome}"
	type="EMAIL" format="HTML" entity="user">
