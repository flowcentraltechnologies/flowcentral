<?xml version="1.0"?>
<!-- Collaboration module configuration -->
<module
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation=" https://schema.flowcentralplatform.com/xsd/4.2.0/flowcentral-module.xsd"
	name="collaboration" description="$m{collaboration.module}" shortCode="CLB"
	label="$m{collaboration.label}">
	<!-- applications -->
	<applications>
		<application name="collaboration"
			shortDescription="$m{collaboration.short.description}"
			longDescription="$m{collaboration.long.description}" autoInstall="true"
			configFile="apps/collaboration-application.xml" />
	</applications>

	<!-- System Parameters -->
</module>